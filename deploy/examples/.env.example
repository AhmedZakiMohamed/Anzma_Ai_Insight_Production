# Copy to .env (never commit .env). Same variable names the app already reads.
PGHOST=localhost
PGPORT=5432
PGDATABASE=anzma
# Optional override when the API uses a pre-existing DB with a different name.
API_PGDATABASE=
PGUSER=postgres
PGPASSWORD=

# Required shared bearer token for dashboard, REST API, and Socket.IO.
# Generate a unique secret locally, e.g. `openssl rand -hex 32`.
ANZMA_API_TOKEN=
ANZMA_COOKIE_SECURE=false
ANZMA_INGEST_RATE_LIMIT_PER_MIN=60
ANZMA_INGEST_RATE_LIMIT_BURST=10
# Optional comma-separated exact http(s) origins; empty keeps browser access same-origin only.
ANZMA_CORS_ALLOWED_ORIGINS=

# Optional freshness evaluator profile. The job keeps one PostgreSQL advisory lock per process.
ANZMA_FRESHNESS_INTERVAL_SECONDS=60
ANZMA_FRESHNESS_LOCK_RETRY_SECONDS=5
ANZMA_SOURCE_SILENCE_MULTIPLIER=3
ANZMA_MASS_STALE_MIN_SERIES=3
ANZMA_MASS_STALE_PERCENT=50

# Optional PostgreSQL backup script settings (scheduling is configured separately).
# ANZMA_BACKUP_MODE=compose
# ANZMA_COMPOSE_FILE=deploy/compose/docker-compose.yml
# ANZMA_COMPOSE_PROJECT=anzma-insight
# ANZMA_BACKUP_DB_SERVICE=db
# ANZMA_BACKUP_DIR=/secure/path/anzma_backups
# ANZMA_BACKUP_KEEP_DAYS=14
# ANZMA_BACKUP_MIN_KEEP=3

# Host-side service bindings. PostgreSQL and Ollama bind to loopback by default.
# Set a bind address to 0.0.0.0 only when deliberate external access is required.
DB_BIND_ADDRESS=127.0.0.1
DB_HOST_PORT=5432
API_HOST_PORT=8000
OLLAMA_BIND_ADDRESS=127.0.0.1
OLLAMA_HOST_PORT=11434

OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120
# Optional: point the API at an Ollama instance outside this Compose project.
# For Ollama running on the Docker host, use http://host.docker.internal:11434
OLLAMA_HOST=
